# Frontend (Vite) — public site and staff app
# Supabase → Settings → API. Use the publishable/anon key only, never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Patient one-time-code channels: phone,email | email | phone
VITE_PATIENT_LOGIN_METHODS=phone,email

# ---- Legacy Express backend (AI voice / telephony only) ----
# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Authentication & Security
JWT_SECRET=
# Optional: password for the legacy backend's seeded accounts in local development
SEED_ADMIN_PASSWORD=
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Vapi Web SDK Voice AI Assistant Configuration
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=

# Google Sheets V1 Appointment Integration (Optional in dev mode - local file fallback used if empty)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# OpenAI GPT-Live-1 Full-Duplex Speech API Configuration
OPENAI_API_KEY=
GPT_LIVE_MODEL=gpt-live-1

# Telephony & Phone Number Configuration
AI_PHONE_NUMBER=+918023456789

# Analytics & Monitoring
ANALYTICS_ID=
